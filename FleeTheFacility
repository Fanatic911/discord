-- ===================== ERREURS VISIBLES (une seule fois par erreur) =====================
local seenErr = {}
local function Report(label, err)
    local key = label .. tostring(err)
    if seenErr[key] then return end
    seenErr[key] = true
    warn("[Flee ESP] " .. label .. " : " .. tostring(err))
end

local function Safe(label, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then Report(label, err) end
    return ok
end

