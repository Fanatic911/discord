local function GetRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function HasTool(name)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    return (bp and bp:FindFirstChild(name) ~= nil)
        or (char and char:FindFirstChild(name) ~= nil)
        or false
end

local function CountTools(holder)
    local n = 0
    if holder then
        for _, t in ipairs(holder:GetChildren()) do
            if t:IsA("Tool") then n = n + 1 end
        end
    end
    return n
end

local function ToolCount()
    return CountTools(LocalPlayer:FindFirstChild("Backpack")) + CountTools(LocalPlayer.Character)
end

-- FIX: snapshot pris ICI, avant tout wait/déplacement
local function NewItemCheck(name)
    local before = ToolCount()
    Log("[NewItemCheck] snapshot before =", before, "| name =", tostring(name))
    return function()
        local got = (name ~= nil and HasTool(name)) or ToolCount() > before
        if got then Log("[NewItemCheck] got item:", tostring(name), "toolCount now =", ToolCount()) end
        return got
    end
end

