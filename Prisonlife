local function GetLunch()
    if not GetRoot() then return Lumen.Notify("Character not found", 2) end

    Log("[GetLunch] searching Models near", tostring(LunchStandPos))

    local bestTargets, bestDist
    for _, m in ipairs(workspace:GetChildren()) do
        if m.Name == "Model" then
            local a = m:FindFirstChild("Part")
            local inner = m:FindFirstChild("Model")
            local b = inner and inner:FindFirstChild("Part")
            local list = {}
            if a and a:IsA("BasePart") then list[#list + 1] = a end
            if b and b:IsA("BasePart") then list[#list + 1] = b end
            if #list > 0 then
                local d = (list[1].Position - LunchStandPos).Magnitude
                Log("[GetLunch] candidate Model =", m:GetFullName(), "| dist =", math.floor(d*10)/10, "| parts =", #list)
                if not bestDist or d < bestDist then
                    bestTargets, bestDist = list, d
                end
            end
        end
    end

    if not bestTargets then
        Log("[GetLunch] no Model found in Workspace")
        return Lumen.Notify("Lunch not found", 3)
    end

    Log("[GetLunch] best target =", bestTargets[1]:GetFullName(), "| dist =", math.floor(bestDist*10)/10)

    -- FIX: snapshot AVANT tout wait
    local checkFn = NewItemCheck(nil)

    local extra = {}
    for i = 2, #bestTargets do extra[#extra + 1] = bestTargets[i] end

    ClickGet("Lunch", LunchStandPos, bestTargets[1], checkFn, extra)
end

local function GetGunWalk(toolName, cf, skipWait, holdSecs)
    local root = GetRoot()
    if not root then return Lumen.Notify("Character not found", 2) end

    if not cf then
        return Lumen.Notify("Position not found", 2)
    end

    if HasTool(toolName) then
        return Lumen.Notify("You already have the " .. toolName, 3)
    end

    Log("[GetGunWalk]", toolName, "| pos =", tostring(cf.Position))

    if not skipWait then WaitMenuClose() end

    root = GetRoot()
    if not root then return end
    local old = root.CFrame

    local giverPart = NearestPart(toolName, cf.Position)
    if giverPart and (giverPart.Position - cf.Position).Magnitude > 20 then
        giverPart = nil
    end
    if giverPart then
        Log("[GetGunWalk]", toolName, "giverPart =", giverPart:GetFullName())
    else
        Log("[GetGunWalk]", toolName, "no giverPart found (will use CFrame only)")
    end

    local deadline = os.clock() + 3
    local got = false
    local flip = false
    local attempts = 0

    while os.clock() < deadline do
        if HasTool(toolName) then got = true break end

        flip = not flip
        root = GetRoot()
        if not root then break end
        root.CFrame = flip and cf or (cf * CFrame.new(0, 0, -5))
        attempts = attempts + 1

        if giverPart and firetouchinterest then
            pcall(firetouchinterest, root, giverPart, 0)
            pcall(firetouchinterest, root, giverPart, 1)
        end

        task.wait(0.15)
    end
    if not got then got = HasTool(toolName) end

    Log("[GetGunWalk]", toolName, got and "SUCCESS" or "TIMEOUT", "| attempts =", attempts)

    if got then
        Lumen.Notify(toolName .. " obtained", 3)
    else
        Lumen.Notify("Timeout: Something was wrong", 4)
    end

    if got and holdSecs then task.wait(holdSecs) end

    root = GetRoot()
    if root then root.CFrame = old end
end

local function Safe(fn)
    if Busy then return end
    Busy = true
    task.spawn(function()
        local ok, err = pcall(fn)
        if not ok then Log("ERROR:", err) end
        pcall(keyrelease, "w")
        pcall(mouse2release)
        pcall(mouse1release)
        if FirstPerson then pcall(ExitFirstPerson) end
        local root = GetRoot()
        if root then root.Anchored = false end
        ShowMenu()
        Busy = false
    end)
end

