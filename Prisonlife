local ArrestDistance = 1
local ArrestTimeout = 8
local CuffName = "Handcuffs"

local function ArrestPlayer(name, silent)
    local function Note(msg, t)
        if not silent then Lumen.Notify(msg, t) end
    end

    if not name then Note("Select a player first", 3) return "invalid" end
    if not GetRoot() then Note("Character not found", 2) return "invalid" end

    if not IsPoliceTeam(TeamOf(LocalPlayer)) then
        Note("Only Police can arrest", 3)
        return "notpolice"
    end

    local target
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p.Name == name then target = p break end
    end
    if not target then Note("Player not found", 3) return "invalid" end

    if not Arrestable(target) then
        Note(name .. " is not arrestable (criminal or hostile inmate only)", 3)
        return "invalid"
    end

    local function Info()
        local c = target.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local head = c and c:FindFirstChild("Head")
        return r, h, head
    end

    local function Health(h)
        local ok, hp = pcall(function() return h.Health end)
        return ok and hp or 0
    end

    local tr0, th0 = Info()
    if not tr0 or not th0 or Health(th0) <= 0 then
        Note(name .. " is not alive", 3)
        return "dead"
    end

    if HasForceField(target) then
        Note(name .. " has a forcefield", 3)
        return "dead"
    end

    if not HasTool(CuffName) then
        Note("You need the Handcuffs", 4)
        return "nocuffs"
    end

    HideMenu()
    task.wait(0.1)

    local root = GetRoot()
    if not root then return "invalid" end
    local old = root.CFrame
    local myChar = LocalPlayer.Character

    local function IAmDead()
        local c = LocalPlayer.Character
        if not c or c ~= myChar then return true end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h then return true end
        local okh, hp = pcall(function() return h.Health end)
        return (not okh) or hp <= 0
    end

    local hadBackpack = target:FindFirstChild("Backpack") ~= nil
    if not hadBackpack and ComputeBackpackCheck() then
        Note(name .. " is already being arrested", 3)
        return "dead"
    end

    if not EquipGun(CuffName) then
        Note("Could not equip the Handcuffs", 5)
        return "noequip"
    end

    local arrested, died, targetDead = false, false, false
    SeatLock(true)
    local tping = false

    local function TPStep()
        if IAmDead() then return end
        KeepStanding()
        local myRoot = GetRoot()
        local tr, _, head = Info()
        if not myRoot or not tr then return end

        local behind = tr.CFrame:PointToWorldSpace(Vector3.new(0, 0, ArrestDistance))
        local aimAt = (head and head.Position) or tr.Position
        pcall(function()
            myRoot.CFrame = CFrame.new(behind, Vector3.new(aimAt.X, behind.Y, aimAt.Z))
        end)
    end

    local ok, err = pcall(function()
        EnterFirstPerson()
        TPStep()

        local r0 = GetRoot()
        if r0 then r0.Anchored = true end

        tping = true
        task.spawn(function()
            local nextAt = os.clock()
            while tping and Alive() do
                pcall(TPStep)
                nextAt = nextAt + TPInterval
                local now = os.clock()
                if nextAt < now then nextAt = now end
                task.wait(nextAt - now)
            end
        end)

        local deadline = os.clock() + ArrestTimeout
        local lastPos
        while os.clock() < deadline and not KillCancel and Alive() do
            if IAmDead() then
                died = true
                KillCancel = true
                break
            end

            if not target.Parent then
                targetDead = true
                break
            end

            if hadBackpack and not target:FindFirstChild("Backpack") then
                arrested = true
                break
            end
            if not Arrestable(target) then
                arrested = true
                break
            end

            local tr, th, head = Info()
            if not tr or not th or Health(th) <= 0 then
                targetDead = true
                break
            end

            if lastPos and (tr.Position - lastPos).Magnitude > 50 then
                arrested = true
                break
            end
            lastPos = tr.Position

            local char = LocalPlayer.Character
            if not (char and char:FindFirstChild(CuffName)) then
                EquipGun(CuffName)
            end

            local aimPart = head or tr
            local cam = workspace.CurrentCamera
            if cam then
                pcall(function() cam.CFrame = CFrame.new(cam.CFrame.Position, aimPart.Position) end)
            end
            local screen, onScreen = World.ToViewport(aimPart.Position)
            if onScreen and screen then
                mousemoveabs(screen.X, screen.Y)
            end
            pcall(mouse1click)

            task.wait(0.05)
        end
    end)
    if not ok then
        Log("Arrest ERROR:", err)
        Note("Arrest error: " .. tostring(err), 5)
    end

    tping = false
    SeatLock(false)
    pcall(mouse1release)
    ExitFirstPerson()

    if not died then
        root = GetRoot()
        if root then
            pcall(function() root.Anchored = false end)
            root.CFrame = old
        end
    end

    if died then
        Lumen.Notify("You died: everything cancelled", 4)
        return "died"
    elseif arrested then
        Note(name .. " arrested", 3)
        return "arrested"
    elseif KillCancel then
        Note("Arrest cancelled", 3)
        return "cancelled"
    elseif targetDead then
        Note(name .. " died / respawned, skipped", 3)
        return "dead"
    elseif ok then
        Note("Could not arrest " .. name .. " in " .. ArrestTimeout .. "s", 4)
        return "timeout"
    end
    return "error"
end

local function ArrestMany(names, silent)
    if #names == 0 then
        if not silent then Lumen.Notify("Select a player first", 3) end
        return "invalid"
    end
    KillCancel = false
    local count, stop = 0, nil
    for _, n in ipairs(names) do
        if KillCancel or not Alive() then stop = "cancelled" break end
        local r = ArrestPlayer(n, silent or #names > 1)
        if r == "arrested" then count = count + 1 end
        if r == "nocuffs" or r == "noequip" or r == "notpolice" or r == "cancelled" or r == "died" then
            stop = r
            break
        end
    end
    if #names > 1 then
        Lumen.Notify("Arrest: " .. count .. "/" .. #names .. " arrested", 4)
    end
    return stop or "done"
end

local function ArrestTeam()
    if not IsPoliceTeam(TeamOf(LocalPlayer)) then
        Lumen.Notify("Only Police can arrest", 3)
        return "notpolice"
    end
    if not HasTool(CuffName) then
        Lumen.Notify("You need the Handcuffs", 4)
        return "nocuffs"
    end

    local list = ArrestTeamList()
    if #list == 0 then
        Lumen.Notify("No one to arrest in: " .. ArrestMode, 3)
        return "empty"
    end

    local r = ArrestMany(list, true)
    return r
end

local AutoFlags = { kill = false, arrest = false, arrestp = false }
local AutoRunning = { kill = false, arrest = false, arrestp = false }
local AutoToggles = {}

local function StopAuto(which)
    AutoFlags[which] = false
    local t = AutoToggles[which]
    if t then pcall(function() t:Set(false) end) end
end

local function StopAllAuto()
    StopAuto("kill")
    StopAuto("arrest")
    StopAuto("arrestp")
    if AutoKillOn then StopAutoKill() end
end

local function StartAuto(which, runFn)
    if AutoRunning[which] then return end
    AutoRunning[which] = true
    task.spawn(function()
        while AutoFlags[which] and Alive() do
            if Busy then
                task.wait(0.5)
            else
                Busy = true
                local ok, r = pcall(runFn)
                Cleanup()
                Busy = false
                if not ok or r == "nogun" or r == "nocuffs" or r == "noequip"
                    or r == "notpolice" or r == "cancelled" or r == "died" then
                    StopAuto(which)
                    break
                end
                ShowMenu()
                task.wait(1)
            end
        end
        AutoRunning[which] = false
        Cleanup()
        ShowMenu()
    end)
end

local function MakePicker(group, title, getList, countWord)
    local P = { page = 1, names = {}, all = {}, current = nil, sel = {}, key = "", getList = getList }

    P.info = group:Label(countWord .. ": 0 | Page 1/1")
    P.selInfo = group:Label("Selected: none (uses the shown player)")
    P.dd = group:Dropdown(title, { "(no players)" }, 1, function(idx, text)
        local n = P.names[idx] or text
        if n and n ~= "(no players)" then P.current = n end
    end)

    local function UpdateSel()
        local chosen = {}
        for _, n in ipairs(P.all) do
            if P.sel[n] then chosen[#chosen + 1] = n end
        end
        local text
        if #chosen == 0 then
            text = "Selected: none (uses the shown player)"
        else
            text = "Selected (" .. #chosen .. "): " .. table.concat(chosen, ", ")
        end
        if #text > 120 then text = text:sub(1, 117) .. "..." end
        pcall(function() P.selInfo:SetText(text) end)
    end

    function P.Refresh()
        local all = getList()
        P.all = all
        P.key = table.concat(all, "|")

        local present = {}
        for _, n in ipairs(all) do present[n] = true end
        for n in pairs(P.sel) do
            if not present[n] then P.sel[n] = nil end
        end

        local pages = math.max(1, math.ceil(#all / PerPage))
        if P.page > pages or P.page < 1 then P.page = 1 end

        local items = {}
        local first = (P.page - 1) * PerPage
        for i = first + 1, math.min(first + PerPage, #all) do
            items[#items + 1] = all[i]
        end

        local keep = 1
        for i, n in ipairs(items) do
            if n == P.current then keep = i break end
        end

        if #items == 0 then
            items = { "(no players)" }
            P.current = nil
        else
            P.current = items[keep]
        end
        P.names = items

        pcall(function() P.dd:SetItems(items) end)
        pcall(function() P.dd:Set(keep) end)
        pcall(function()
            P.info:SetText(countWord .. ": " .. #all .. " | Page " .. P.page .. "/" .. pages)
        end)
        UpdateSel()
    end

    function P.Names()
        local out = {}
        for _, n in ipairs(P.all) do
            if P.sel[n] then out[#out + 1] = n end
        end
        if #out == 0 and P.current then out[1] = P.current end
        return out
    end

    function P.Check()
        local ok, all = pcall(getList)
        if ok and table.concat(all, "|") ~= P.key then
            pcall(P.Refresh)
        end
    end

    group:Button("Refresh players", function() P.Refresh() end)
    group:Button("Next page (" .. PerPage .. " players per page)", function()
        P.page = P.page + 1
        P.Refresh()
    end)
    group:Button("Select / Unselect shown player", function()
        if P.current then
            if P.sel[P.current] then P.sel[P.current] = nil else P.sel[P.current] = true end
            UpdateSel()
        end
    end)
    group:Button("Select all players", function()
        for _, n in ipairs(P.all) do P.sel[n] = true end
        UpdateSel()
    end)
    group:Button("Clear selection", function()
        P.sel = {}
        UpdateSel()
    end)

    return P
end

