    if not GetRoot() then Note("Character not found", 2) return "invalid" end

    local target
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p.Name == name then target = p break end
    end
    if not target then Note("Player not found", 3) return "invalid" end

    local myTeam, theirTeam = TeamOf(LocalPlayer), TeamOf(target)
    if myTeam and theirTeam and myTeam == theirTeam then
        Note(name .. " is in your team", 3)
        return "invalid"
    end

    local function Info()
        local c = target.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local head = c and c:FindFirstChild("Head")
        return r, h, head
    end

    local function Health(h)
        local ok, hp = pcall(function() return h.Health end)
        return ok and hp or 0
    end

    local tr0, th0 = Info()
    if not tr0 or not th0 or Health(th0) <= 0 then
        Note(name .. " is not alive", 3)
        return "dead"
    end

    if HasForceField(target) then
        Note(name .. " has a forcefield", 3)
        return "dead"
    end

    if not HasTool(KillGun) then
        Note("You need the Remington: press 'Recup the Remington' first", 4)
        return "nogun"
    end

    HideMenu()
    task.wait(0.1)

    local root = GetRoot()
    if not root then return "invalid" end
    local old = root.CFrame
    local myChar = LocalPlayer.Character

    local function IAmDead()
        local c = LocalPlayer.Character
        if not c or c ~= myChar then return true end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h then return true end
        local okh, hp = pcall(function() return h.Health end)
        return (not okh) or hp <= 0
    end

    if not EquipGun(KillGun) then
        Note("Could not equip the Remington", 5)
        return "noequip"
    end

    local s = GunSettings[KillGun]
    local saved = {
        master = ModsEnabled,
        auto = s.on.fullauto,
        spread = s.on.spread, spreadVal = s.val.spread,
    }
    ModsEnabled = true
    s.on.fullauto = true
    s.on.spread = true; s.val.spread = 0

    do
        local char = LocalPlayer.Character
        local gun = char and char:FindFirstChild(KillGun)
        if gun then
            pcall(ApplyMods, gun)
        end
    end

    local killed, sawAlive, died = false, false, false
    SeatLock(true)
    local pressed = false
    local tping = false

    local function Release()
        if pressed then
            pcall(mouse1release)
            pressed = false
        end
    end

    local function TPStep()
        if IAmDead() then return end
        KeepStanding()
        local myRoot = GetRoot()
        local tr, _, head = Info()
        if not myRoot or not tr then return end

        local behind = tr.CFrame:PointToWorldSpace(Vector3.new(0, 0, distance))
        local aimAt = (head and head.Position) or tr.Position
        pcall(function()
            myRoot.CFrame = CFrame.new(behind, Vector3.new(aimAt.X, behind.Y, aimAt.Z))
        end)

        local cam = workspace.CurrentCamera
        if cam then
            pcall(function() cam.CFrame = CFrame.new(cam.CFrame.Position, aimAt) end)
        end
    end

    local ok, err = pcall(function()
        EnterFirstPerson()
        TPStep()

        local r0 = GetRoot()
        if r0 then r0.Anchored = true end

        tping = true
        task.spawn(function()
            local nextAt = os.clock()
            while tping and Alive() do
                pcall(TPStep)
                nextAt = nextAt + TPInterval
                local now = os.clock()
                if nextAt < now then nextAt = now end
                task.wait(nextAt - now)
            end
        end)

        local deadline = os.clock() + KillTimeout
        local lastReload = 0
        local lastAmmo, lastChange = nil, os.clock()
        local repress = s.on.firerate and 0.12 or 0.4

        while os.clock() < deadline and not KillCancel and Alive() do
            if IAmDead() then
                died = true
                KillCancel = true
                break
            end

            local tr, th, head = Info()
            if not tr or not th then
                if sawAlive then killed = true end
                break
            end
            if Health(th) <= 0 then killed = true break end
            sawAlive = true

            local char = LocalPlayer.Character
            local gun = char and char:FindFirstChild(KillGun)
            if gun then
                local aimPart = head or tr
                local cam = workspace.CurrentCamera
                if cam then
                    pcall(function() cam.CFrame = CFrame.new(cam.CFrame.Position, aimPart.Position) end)
                end
                local screen, onScreen = World.ToViewport(aimPart.Position)
                if onScreen and screen then
                    mousemoveabs(screen.X, screen.Y)
                end

                pcall(ApplyMods, gun)

                local ammo = tonumber(GetAttr(gun, "Local_CurrentAmmo")) or 1
                local reloading = tostring(GetAttr(gun, "IsReloading")) == "true"

                if ammo <= 0 then
                    Release()
                    if not reloading and os.clock() - lastReload > ReloadDelay then
                        pcall(keyclick, "r")
                        lastReload = os.clock()
                    end
                elseif reloading then
                    Release()
                else
                    if not pressed then
                        pcall(mouse1press)
                        pressed = true
                        lastChange = os.clock()
                    end

                    if lastAmmo ~= ammo then
                        lastAmmo = ammo
                        lastChange = os.clock()
                    elseif os.clock() - lastChange > repress then
                        Release()
                        pcall(mouse1press)
                        pressed = true
                        lastChange = os.clock()
                    end
                end
            else
                Release()
                EquipGun(KillGun)
            end

            task.wait()
        end
    end)
    if not ok then
        Log("Kill ERROR:", err)
        Note("Kill error: " .. tostring(err), 5)
    end

    tping = false
    SeatLock(false)
    Release()
    pcall(mouse1release)
    s.on.fullauto = saved.auto
    s.on.spread = saved.spread;   s.val.spread = saved.spreadVal
    ModsEnabled = saved.master
    ExitFirstPerson()

    if not died then
        root = GetRoot()
        if root then
            pcall(function() root.Anchored = false end)
            root.CFrame = old
        end
    end

    if died then
        Lumen.Notify("You died: everything cancelled", 4)
        return "died"
    elseif killed then
        Note(name .. " killed", 3)
        return "killed"
    elseif KillCancel then
        Note("Kill cancelled", 3)
        return "cancelled"
    elseif ok then
        Note("Not dead after " .. KillTimeout .. "s, back to start", 4)
        return "timeout"
    end
    return "error"
end

