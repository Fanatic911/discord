local function NearestPart(name, from)
    local items = workspace:FindFirstChild("Prison_ITEMS")
    local giver = items and items:FindFirstChild("giver")
    if not giver then return nil end

    local best, bestDist
    for _, model in ipairs(giver:GetChildren()) do
        if model.Name == name then
            for _, obj in ipairs(model:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local d = (obj.Position - from).Magnitude
                    if not bestDist or d < bestDist then
                        best, bestDist = obj, d
                    end
                end
            end
        end
    end
    return best
end

local function NearestChild(container, name, from, maxDist)
    if not container then return nil end
    local best, bestDist
    for _, obj in ipairs(container:GetChildren()) do
        if obj.Name == name and obj:IsA("BasePart") then
            local d = (obj.Position - from).Magnitude
            if d <= maxDist and (not bestDist or d < bestDist) then
                best, bestDist = obj, d
            end
        end
    end
    return best
end

local function GiverCF(name)
    local part = NearestPart(name, PoliceArea)
    return part and CFrame.new(part.Position)
end

local function TPBack(cf, delay)
    if not cf then
        return Lumen.Notify("Position not found", 2)
    end
    local root = GetRoot()
    if not root then return end

    local old = root.CFrame
    root.CFrame = cf
    task.wait(delay or 0.5)

    root = GetRoot()
    if root then
        root.CFrame = old
        Lumen.Notify("Teleportation successful", 2)
    end
end

local function IsFirstPerson()
    local char = LocalPlayer.Character
    local head = char and char:FindFirstChild("Head")
    local cam = workspace.CurrentCamera
    if not head or not cam then return false end
    local d = (cam.CFrame.Position - head.Position).Magnitude
    return d < 2, d
end

local function EnterFirstPerson()
    local function try(label, fn)
        local ok, err = pcall(fn)
        Log(label, ok and "OK" or ("refused: " .. tostring(err)))
        return ok
    end

    try("CameraMode", function()
        LocalPlayer:SetProperty("CameraMode", "LockFirstPerson")
    end)
    try("ZoomDistance", function()
        LocalPlayer:SetProperty("CameraMinZoomDistance", 0.5)
        LocalPlayer:SetProperty("CameraMaxZoomDistance", 0.5)
    end)

    task.wait(0.4)

    for _ = 1, 40 do
        local ok, dist = IsFirstPerson()
        if ok then
            Log("first person OK (distance =", dist, ")")
            FirstPerson = true
            return true
        end
        pcall(mousescroll, 1)
        task.wait(0.05)
    end

    local _, dist = IsFirstPerson()
    Log("first person FAILED (distance =", dist, ")")
    return false
end

local function ExitFirstPerson()
    FirstPerson = false
    pcall(function() LocalPlayer:SetProperty("CameraMode", "Classic") end)
    pcall(function()
        LocalPlayer:SetProperty("CameraMinZoomDistance", 0.5)
        LocalPlayer:SetProperty("CameraMaxZoomDistance", 128)
    end)
    for _ = 1, 8 do pcall(mousescroll, -1) task.wait(0.02) end
    Log("normal view restored")
end

local function AimCamera(part, deadline)
    local cam = workspace.CurrentCamera
    pcall(function() cam.CFrame = CFrame.new(cam.CFrame.Position, part.Position) end)
    task.wait(0.1)

    for i = 1, 40 do
        if os.clock() > deadline then return false end

        local cam2 = workspace.CurrentCamera
        local target, onScreen = World.ToViewport(part.Position)
        local center = World.ToViewport(cam2.CFrame.Position + cam2.CFrame.LookVector * 100)
        local dx = target.X - center.X
        local dy = target.Y - center.Y

        if onScreen and math.abs(dx) < 20 and math.abs(dy) < 20 then
            return true
        end
        if target.Z < 0 then dx = 300 end

        local stepX = math.clamp(dx * 0.5, -150, 150)
        local stepY = math.clamp(dy * 0.5, -100, 100)

        if FirstPerson then
            mousemoverel(stepX, stepY)
        else
            mouse2press()
            task.wait(0.03)
            mousemoverel(stepX, stepY)
            task.wait(0.03)
            mouse2release()
        end
        task.wait(0.08)
    end
    return false
end

