local function ClickGet(label, standPos, part, hasFn, extraTargets)
    local root = GetRoot()
    if not root then return Lumen.Notify("Character not found", 2) end

    local targets = { part }
    if extraTargets then
        for _, t in ipairs(extraTargets) do targets[#targets + 1] = t end
    end

    Log("[ClickGet]", label, "| part =", part:GetFullName(), "| targets =", #targets)

    WaitMenuClose()

    root = GetRoot()
    if not root then return end
    local old = root.CFrame

    root.CFrame = CFrame.new(standPos, Vector3.new(part.Position.X, standPos.Y, part.Position.Z))
    root.Anchored = true
    task.wait(0.3)

    EnterFirstPerson()

    local deadline = os.clock() + ClickTimeout

    Log("[ClickGet]", label, "camera centered =", AimCamera(part, deadline))

    local got = false

    if hasFn then
        local attempts = 0
        while os.clock() < deadline do
            if hasFn() then got = true break end

            for _, target in ipairs(targets) do
                local screen, onScreen = World.ToViewport(target.Position)
                if onScreen then
                    mousemoveabs(screen.X, screen.Y)
                    task.wait(0.1)
                    mouse1click()
                    attempts = attempts + 1
                    Log("[ClickGet]", label, "click #"..attempts, "on", target:GetFullName())
                end
                if hasFn() then break end
            end
            task.wait(0.4)
        end
        if not got then got = hasFn() end
    else
        for _ = 1, 3 do
            for _, target in ipairs(targets) do
                local screen, onScreen = World.ToViewport(target.Position)
                if onScreen then
                    mousemoveabs(screen.X, screen.Y)
                    task.wait(0.1)
                    mouse1click()
                    Log("[ClickGet]", label, "click (no hasFn) on", target:GetFullName())
                end
            end
            task.wait(0.4)
        end
        got = true
    end

    if got then
        Log("[ClickGet]", label, "SUCCESS")
        Lumen.Notify(label .. " obtained", 3)
    else
        Log("[ClickGet]", label, "TIMEOUT")
        Lumen.Notify("Timeout: Something was wrong", 4)
    end

    ExitFirstPerson()
    root = GetRoot()
    if root then
        root.Anchored = false
        root.CFrame = old
    end
end

local function ClickSweep(label, standPos, hasFn)
    local root = GetRoot()
    if not root then return Lumen.Notify("Character not found", 2) end

    Log("[ClickSweep]", label, "| standPos =", tostring(standPos))

    WaitMenuClose()

    root = GetRoot()
    if not root then return end
    local old = root.CFrame

    root.CFrame = CFrame.new(standPos)
    root.Anchored = true
    task.wait(0.4)

    EnterFirstPerson()
    task.wait(0.2)

    local cam = workspace.CurrentCamera
    local cx, cy = 640, 360
    if cam then
        local center = World.ToViewport(cam.CFrame.Position + cam.CFrame.LookVector * 100)
        if center and center.X > 100 and center.Y > 100 then
            cx, cy = center.X, center.Y
        end
    end

    local points = {}
    local step = 32
    local halfW, halfH = cx * 0.9, cy * 0.9
    local x = -halfW
    while x <= halfW do
        local y = -halfH
        while y <= halfH do
            points[#points + 1] = { cx + x, cy + y, x * x + y * y }
            y = y + step
        end
        x = x + step
    end
    table.sort(points, function(a, b) return a[3] < b[3] end)

    Log("[ClickSweep]", label, "| sweep grid =", #points, "points")

    local deadline = os.clock() + SweepTimeout
    local got = false
    local totalClicks = 0

    while os.clock() < deadline and not got do
        for i, p in ipairs(points) do
            mousemoveabs(p[1], p[2])
            task.wait(0.02)
            mouse1click()
            totalClicks = totalClicks + 1
            task.wait(0.03)
            if i % 4 == 0 then
                if hasFn() then got = true break end
            end
            if os.clock() > deadline then break end
        end
        if not got then
            Log("[ClickSweep]", label, "pass done | clicks =", totalClicks, "| elapsed =", math.floor((os.clock()-(deadline-SweepTimeout))*10)/10 .. "s")
            got = hasFn()
        end
    end

    if got then
        Log("[ClickSweep]", label, "SUCCESS | total clicks =", totalClicks)
        Lumen.Notify(label .. " obtained", 3)
    else
        Log("[ClickSweep]", label, "TIMEOUT | total clicks =", totalClicks)
        Lumen.Notify("Timeout: Something was wrong", 4)
    end

    ExitFirstPerson()
    root = GetRoot()
    if root then
        root.Anchored = false
        root.CFrame = old
    end
end

