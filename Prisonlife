        task.wait(1)
        if not Alive() then break end
        if not Busy then
            local okl, lbl = pcall(TeamTargetLabel)
            if okl and lbl ~= LastTeamLabel then
                LastTeamLabel = lbl
                pcall(function() TeamDropdown:SetItems({ lbl }) end)
                pcall(function() TeamDropdown:Set(1) end)
            end

            if KillPicker then KillPicker.Check() end
            if ArrestPicker then ArrestPicker.Check() end

            -- Refresh du status des mods en arrière-plan
            pcall(RefreshStatus)
        end
    end
end)

pcall(function()
    game.Players.PlayerAdded:Connect(function()
        task.delay(0.5, function() if Alive() then RefreshPlayers() end end)
    end)
end)
pcall(function()
    game.Players.PlayerRemoving:Connect(function()
        task.delay(0.5, function() if Alive() then RefreshPlayers() end end)
    end)
end)


-- ===================== MISC =====================
local function BuildMisc()
    local RunService = game:GetService("RunService")

    local Tab = MiscTab
    if not Tab then
        local W = UI.Window({
            Title = "Misc",
            Key   = "misc_menu",
            Width = 600,
            Height = 300,
        })
        W:SetVisible(true)
        W:BindToMenu(true)
        Tab = W:Tab("Misc")
    end

    local MiscGroup = Tab:Section("Misc")

    -- ---- Delete All Doors (bouton, exécution unique) ----
    MiscGroup:Button("Delete All Doors", function()
        local count = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name:lower():find("door", 1, true) then
                local ok = pcall(function() obj:Destroy() end)
                if ok then count = count + 1 end
            end
        end
        Lumen.Notify("Doors deleted: " .. count, 2)
    end)

    -- ---- Give All Guns (local) ----
    MiscGroup:Button("Give All Guns (local)", function()
        local tools = game.ReplicatedStorage:FindFirstChild("Tools")
        if not tools then
            Lumen.Notify("ReplicatedStorage.Tools not found", 3)
            return
        end
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if not bp then
            Lumen.Notify("Backpack not found", 3)
            return
        end
        local count = 0
        for _, tool in ipairs(tools:GetChildren()) do
            if tool:IsA("Tool") then
                -- Lumen: Clone prend le parent en premier argument
                local ok = pcall(function() tool:Clone(bp) end)
                if ok then count = count + 1 end
            end
        end
        Lumen.Notify("Gave " .. count .. " tools to backpack", 3)
    end)

    -- ---- Rainbow Mode ----
    local rainbowConn = nil
    local rainbowHue  = 0

    MiscGroup:Toggle("Rainbow Mode", false, function(state)
        if rainbowConn then rainbowConn:Disconnect() rainbowConn = nil end
        if state then
            Lumen.Notify("Rainbow Mode ON", 2)
            rainbowConn = RunService.Heartbeat:Connect(function(dt)
                rainbowHue = (rainbowHue + dt * 0.3) % 1
                local color = Color3.fromHSV(rainbowHue, 1, 1)
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        pcall(function() obj.Color = color end)
                    end
                end
            end)
        else
            Lumen.Notify("Rainbow Mode OFF", 2)
        end
    end)
end

BuildMisc()

-- ===================== SETTINGS =====================
local function BuildSettings()
    local SettingsGroup = SettingsTab:Section("Settings")

    local KeyList = {
        "insert", "rightshift", "rightcontrol", "delete", "home", "end",
        "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12",
        "p", "m", "k"
    }
    local MenuKey = KeyList[1]
    local KeyWarned = false

    SettingsGroup:Paragraph("open/close menu", "Pick a key below. Press it in game to hide or show the menu.")
    local KeyLabel = SettingsGroup:Label("Current key: " .. MenuKey)

    SettingsGroup:Dropdown("open/close menu", KeyList, 1, function(idx, text)
        MenuKey = KeyList[idx] or text or KeyList[1]
        pcall(function() KeyLabel:SetText("Current key: " .. MenuKey) end)
        Lumen.Notify("open/close menu key: " .. MenuKey, 2)
    end)

    SettingsGroup:Button("open/close menu (test)", function()
        ToggleMenu()
    end)

    task.spawn(function()
        local wasDown = false
        while Alive() do
            task.wait(0.05)
            local ok, down = pcall(iskeypressed, MenuKey)
            if ok then
                down = down == true
                if down and not wasDown and not Busy then
                    ToggleMenu()
                end
                wasDown = down
            elseif not KeyWarned then
                KeyWarned = true
                Log("[Settings] iskeypressed failed:", tostring(down))
                Lumen.Notify("Key detection not supported here", 4)
            end
        end
    end)
end

BuildSettings()
