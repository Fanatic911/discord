-- FIX: clé avec séparateur explicite pour éviter les collisions "M4A1.FireRate"+"missing" vs "M4A1.FireRate"+"ignored"
local function Report(key, ...)
    if Reported[key] then return end
    Reported[key] = true
    Log("[Mods]", ...)
end

local function Quantize(slider, v)
    if slider.int then return math.floor(v + 0.5) end
    return math.floor(v * 100 + 0.5) / 100
end

local function Same(a, b)
    if type(a) == "number" and type(b) == "number" then
        return math.abs(a - b) < 0.0001
    end
    return a == b
end

local function GetAttr(tool, attr)
    local ok, v = pcall(function() return tool:GetAttribute(attr) end)
    if ok then return v end
    return nil
end

local function ToolKey(tool)
    local ok, addr = pcall(function() return tool.Address end)
    return tool.Name .. ":" .. (ok and tostring(addr) or "?")
end

local function Drive(tool, attr, on, value)
    local issueKey = tool.Name .. "." .. attr
    local store = Originals[ToolKey(tool)]

    if not on then
        Issues[issueKey] = nil
        if store and store.attrs[attr] ~= nil then
            local orig = store.attrs[attr].orig
            store.attrs[attr] = nil
            pcall(function() tool:SetAttribute(attr, orig) end)
        end
        return
    end

    local cur = GetAttr(tool, attr)
    if cur == nil then
        Issues[issueKey] = "missing"
        -- FIX: clé séparée par ":missing" et ":ignored" pour que Report déduplique correctement
        Report(issueKey .. ":missing", tool.Name, "does not have attribute", attr, "(ignored)")
        return
    end

    if not store then
        store = { tool = tool, attrs = {} }
        Originals[ToolKey(tool)] = store
    end

    local rec = store.attrs[attr]
    if not rec then
        rec = { orig = cur, miss = 0 }
        store.attrs[attr] = rec
    end

    if Same(cur, value) then
        rec.miss = 0
        Issues[issueKey] = nil
        return
    end

    pcall(function() tool:SetAttribute(attr, value) end)
    rec.miss = rec.miss + 1
    if rec.miss >= 20 then
        Issues[issueKey] = "ignored"
        Report(issueKey .. ":ignored", tool.Name, attr, "is reset or ignored by the game")
    end
end

local function RestoreAll()
    for key, store in pairs(Originals) do
        if store.tool then
            for attr, rec in pairs(store.attrs) do
                pcall(function() store.tool:SetAttribute(attr, rec.orig) end)
            end
        end
        Originals[key] = nil
    end
end

local function ApplyMods(tool)
    local s = GunSettings[tool.Name]
    if not s then return end

    for _, m in ipairs(Mods) do
        local on = ModsEnabled and s.on[m.key]
        for _, a in ipairs(m.attrs) do
            local v
            if a.fixed ~= nil then
                v = a.fixed
            else
                v = s.val[m.key]
            end
            -- v peut être 0 (number) quand le slider est à son minimum : c'est valide
            Drive(tool, a.name, on, v)
        end
    end

    if ModsEnabled and s.on.infammo then
        local max = tonumber(GetAttr(tool, "MaxAmmo"))
        if max then
            for _, name in ipairs({ "CurrentAmmo", "Local_CurrentAmmo" }) do
                local cur = tonumber(GetAttr(tool, name))
                if cur and cur < max then
                    pcall(function() tool:SetAttribute(name, max) end)
                end
            end
        end
    end
end

local function ForEachGun(fn, includeBackpack)
