    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and GunSettings[t.Name] then fn(t) end
        end
    end
    if includeBackpack then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and GunSettings[t.Name] then fn(t) end
            end
        end
    end
end

local function RefreshStatus()
    if not StatusLabel then return end

    local equipped
    local char = LocalPlayer.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and GunSettings[t.Name] then
                equipped = t.Name
                break
            end
        end
    end

    local text
    if not ModsEnabled then
        text = "Mods are OFF (original values restored)"
    elseif equipped then
        local count = 0
        for _, v in pairs(GunSettings[equipped].on) do
            if v then count = count + 1 end
        end
        text = "Equipped: " .. equipped .. " | Active mods: " .. count

        local bad = {}
        local prefix = equipped .. "."
        for key, kind in pairs(Issues) do
            if key:sub(1, #prefix) == prefix then
                local name = key:sub(#prefix + 1)
                bad[#bad + 1] = name .. (kind == "missing" and " (not on this gun)" or " (ignored by game)")
            end
        end
        if #bad > 0 then
            text = text .. " | " .. table.concat(bad, ", ")
        end
    else
        text = "Equipped: no gun"
    end

    if text ~= LastStatus then
        LastStatus = text
        StatusLabel:SetText(text)
    end
end

local function AddMod(group, m)
    local toggle = group:Toggle(m.toggle, false, function(state)
        if Syncing then return end
        GunSettings[SelectedGun].on[m.key] = state
    end)
    Handles.on[m.key] = toggle
    if toggle and m.hint then
        pcall(function() toggle:SetHint(m.hint) end)
    end

    if m.slider then
        local sl = m.slider
        local function OnValue(v)
            if Syncing then return end
            GunSettings[SelectedGun].val[m.key] = Quantize(sl, v)
        end
        local handle
        if sl.int then
            handle = group:SliderInt(sl.label, sl.min, sl.max, sl.default, OnValue)
        else
            handle = group:Slider(sl.label, sl.min, sl.max, sl.default, OnValue)
        end
        Handles.val[m.key] = handle
    end
end

local function ModByKey(key)
