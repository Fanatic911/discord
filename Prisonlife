local function TeamOf(p)
    local name, color
    pcall(function()
        local t = p.Team
        if t then name = tostring(t.Name) end
    end)
    pcall(function() color = tostring(p.TeamColor) end)
    if not name and not color then return nil end
    return (name or "?") .. " | " .. (color or "?")
end

local function IsPoliceTeam(t)
    if not t then return false end
    t = tostring(t):lower()
    return t:find("guard") ~= nil or t:find("police") ~= nil
        or t:find("cop") ~= nil or t:find("bright blue") ~= nil
end

local function IsCriminalTeam(t)
    if not t then return false end
    t = tostring(t):lower()
    return t:find("criminal") ~= nil or t:find("really red") ~= nil
end

local function IsInmateTeam(t)
    if not t then return false end
    t = tostring(t):lower()
    return t:find("inmate") ~= nil or t:find("prisoner") ~= nil
        or t:find("bright orange") ~= nil or t:find("neon orange") ~= nil
end

local WeaponKeys = { "knife", "hammer", "revolver", "fal", "remington", "m9", "m4a1", "m700", "ak-47", "mp5", "c4" }

local function IsWeaponName(n)
    n = tostring(n):lower()
    for _, k in ipairs(WeaponKeys) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function HasWeapon(p)
    local ok, res = pcall(function()
        local c = p.Character
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and IsWeaponName(t.Name) then return true end
            end
        end
        local bp = p:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and IsWeaponName(t.Name) then return true end
            end
        end
        return false
    end)
    return ok and res == true
end

local function IsHostile(p)
    local ok, res = pcall(function()
        local c = p.Character
        return c ~= nil and c:GetAttribute("Hostile") == true
    end)
    return ok and res == true
end

local function IsArmedInmate(p)
    return IsInmateTeam(TeamOf(p)) and (IsHostile(p) or HasWeapon(p))
end

local function Arrestable(p)
    local t = TeamOf(p)
    if IsCriminalTeam(t) then return true end
    return IsInmateTeam(t) and (IsHostile(p) or HasWeapon(p))
end

local function HasForceField(p)
    local ok, res = pcall(function()
        local c = p.Character
        return c ~= nil and c:FindFirstChildOfClass("ForceField") ~= nil
    end)
    return ok and res == true
end

local BackpackCheck = false

local function ComputeBackpackCheck()
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= LocalPlayer and p:FindFirstChild("Backpack") then return true end
    end
    return false
end

local function Listable(p)
    if p == LocalPlayer then return false end
    if HasForceField(p) then return false end
    if BackpackCheck and not p:FindFirstChild("Backpack") then return false end
    return true
end

local function PlayersWhere(filter)
    BackpackCheck = ComputeBackpackCheck()
    local list = {}
    for _, p in ipairs(game.Players:GetPlayers()) do
        if Listable(p) and filter(p) then list[#list + 1] = p.Name end
    end
    table.sort(list, function(a, b) return a:lower() < b:lower() end)
    return list
end

local function OtherPlayers()
    if IsPoliceTeam(TeamOf(LocalPlayer)) then
        return PlayersWhere(Arrestable)
    end
    return PlayersWhere(function(p) return IsPoliceTeam(TeamOf(p)) end)
end

local ArrestModes = { "Criminals", "Hostile Inmates", "Criminals + Hostile Inmates" }
local ArrestMode = ArrestModes[1]

local function ArrestTeamList()
    if not IsPoliceTeam(TeamOf(LocalPlayer)) then return {} end
    return PlayersWhere(function(p)
        if ArrestMode == "Criminals" then
            return IsCriminalTeam(TeamOf(p))
        elseif ArrestMode == "Hostile Inmates" then
            return IsArmedInmate(p)
        end
        return Arrestable(p)
    end)
end

local function ArrestablePlayers()
    if not IsPoliceTeam(TeamOf(LocalPlayer)) then return {} end
    return PlayersWhere(Arrestable)
end

